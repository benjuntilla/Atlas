<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging. Every line is one JSON object with at minimum:
    timestamp, level, logger, message, thread, and (when in scope) MDC keys.
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"atlas-payments"}</customFields>
            <includeMdc>true</includeMdc>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Reduce Exposed, Hikari, Kafka, and Netty noise unless debugging. -->
    <logger name="Exposed" level="WARN" />
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="org.apache.kafka" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="io.ktor" level="WARN" />

</configuration>
